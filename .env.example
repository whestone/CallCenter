DATABASE_URL=postgres://postgres:callcenter@localhost:5432/callcenter
BIND_ADDR=127.0.0.1:3000
RUST_LOG=callcenter=info,tower_http=info

# Landesvorwahl für nationale Rufnummern – besser unter Verwaltung → Einstellungen
DEFAULT_COUNTRY_CODE=49

# Werden nur beim allerersten Start (leere Datenbank) verwendet.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=agent123
SEED_CUSTOMER_PASSWORD=kunde1234

# Demo-Anmeldung per Knopfdruck (nur für lokale Demos, nie produktiv!)
DEMO_LOGIN=false
SEED_CUSTOMER_EMAIL=max@acme.example

# E-Mail-Versand: besser unter Verwaltung → E-Mail einrichten. Die Werte hier gelten nur,
# solange dort nichts eingetragen ist (ohne beides: Mails nur im Postausgang).
# Öffentliche Adresse – besser unter Verwaltung → Einstellungen
PUBLIC_URL=http://127.0.0.1:3000
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=support@example.com
#SMTP_SECURITY=starttls
# Eingehende E-Mails per Webhook – besser unter Verwaltung → E-Mail aktivieren (mind. 16 Zeichen)
#INBOUND_EMAIL_SECRET=

# Telefonie – besser unter Verwaltung → Telefonie einrichten; gilt nur ohne Eintrag dort.
# TELEPHONY_SECRET=bitte-langes-zufaelliges-geheimnis
# Click-to-Call über sipgate (Personal Access Token mit Scope sessions:calls:write)
# SIPGATE_TOKEN_ID=token-XXXXXX
# SIPGATE_TOKEN=...

# E-Mail-Eingang per IMAP-Abruf – besser unter Verwaltung → E-Mail einrichten; gilt nur ohne Eintrag dort
# IMAP_HOST=imap.example.com
# IMAP_USER=support@example.com
# IMAP_PASSWORD=...
# IMAP_FOLDER=INBOX
# IMAP_POLL_SECONDS=60

# Zeiten – besser unter Verwaltung → Einstellungen; gelten nur ohne Eintrag dort.
# SLA-Warnung so viele Minuten vor Ablauf (Standard 30)
# SLA_WARN_MINUTES=30

# Routing nach Fähigkeiten: so viele Minuten auf einen passenden Agenten warten (Standard 30)
# SKILL_TIMEOUT_MINUTES=30
